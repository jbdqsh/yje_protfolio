---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
const responsibilitiesTitle =
  project.responsibilitiesLabel ?? (project.kind === 'concept' ? '设计范围' : '我的职责');
const sections = [
  { id: 'background', title: '项目背景' },
  { id: 'responsibilities', title: responsibilitiesTitle },
  ...(project.architecture.length ? [{ id: 'structure', title: '技术架构' }] : []),
  ...(project.challenges.length ? [{ id: 'challenges', title: '难点与方案' }] : []),
  { id: 'reflection', title: '延伸思考' },
];
---

<BaseLayout title={`${project.name} · 项目案例 · 严加恩`} description={project.summary}>
  <article class="container project-detail">
    <a class="back-link" href="/#projects">
      ← 返回精选项目
    </a>
    <div class="detail-heading">
      <p class="eyebrow">
        PROJECT {project.number} / {project.category}
      </p>
      <h1>{project.name}</h1>
      <p class="detail-subtitle">{project.subtitle}</p>
      {project.kind === 'concept' && (
        <p class="concept-notice">概念设计 · 用于展示产品与架构思考，尚未实现或交付。</p>
      )}
    </div>
    <div class="project-facts">
      {project.period && (
        <div>
          <span>时间</span>
          <strong>{project.period}</strong>
        </div>
      )}
      {project.role && (
        <div>
          <span>{project.kind === 'concept' ? '设计范围' : '我的角色'}</span>
          <strong>{project.role}</strong>
        </div>
      )}
      <div>
        <span>{project.tagsLabel ?? '核心技术'}</span>
        <strong>{project.tags.join(' / ')}</strong>
      </div>
    </div>
    <ProjectGallery project={project} />
    <div class="detail-content">
      <aside class="detail-sidebar">
        <span class="eyebrow">IN THIS PROJECT</span>
        {sections.map((section, index) => (
          <a href={`#${section.id}`}>
            {String(index + 1).padStart(2, '0')} {section.title}
          </a>
        ))}
        <div class="project-external">
          {project.github ? (
            <a href={project.github} target="_blank" rel="noreferrer">
              GitHub <Icon size={14} />
            </a>
          ) : (
            <span>GitHub · 暂未公开</span>
          )}
          {project.demo ? (
            <a href={project.demo} target="_blank" rel="noreferrer">
              在线演示 <Icon size={14} />
            </a>
          ) : (
            <span>在线演示 · 暂未公开</span>
          )}
        </div>
      </aside>
      <div class="detail-body">
        <section id="background">
          <h2>项目背景</h2>
          <p>{project.background}</p>
        </section>
        <section id="responsibilities">
          <h2>{responsibilitiesTitle}</h2>
          {project.evidenceNote && <p class="muted">{project.evidenceNote}</p>}
          <ul>
            {project.responsibilities.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
        {project.architecture.length > 0 && (
          <section id="structure">
            <h2>技术架构</h2>
            <p class="muted">
              {project.kind === 'concept' ? '以下为拟议架构。' : '根据项目经历整理的简化结构。'}
            </p>
            <ol class="detail-architecture">
              {project.architecture.map((layer, index) => (
                <li>
                  <span class="mono">0{index + 1}</span>
                  {layer}
                </li>
              ))}
            </ol>
          </section>
        )}
        {project.challenges.length > 0 && (
          <section id="challenges">
            <h2>难点与方案</h2>
            {project.challenges.map((challenge) => (
              <div class="challenge">
                <h3>{challenge.title}</h3>
                <p>{challenge.problem}</p>
                <div>
                  <span class="challenge-label">
                    {project.kind === 'concept' ? '设计思路' : '处理方式'}
                  </span>
                  <p>{challenge.solution}</p>
                </div>
              </div>
            ))}
          </section>
        )}
        <section id="reflection">
          <h2>延伸思考</h2>
          <p>{project.reflection}</p>
        </section>
      </div>
    </div>
    <a href={`/projects/${next.slug}/`} class="next-project">
      <div>
        <span class="eyebrow">NEXT PROJECT / 下一个项目</span>
        <h2>{next.name}</h2>
      </div>
      <Icon size={35} />
    </a>
  </article>
</BaseLayout>
