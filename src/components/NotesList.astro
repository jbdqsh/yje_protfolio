---
import { getCollection } from 'astro:content';
import { copy } from '../data/site';
import Icon from './Icon.astro';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---

<section id="notes" class="container section notes-section" aria-labelledby="notes-title">
  <p class="eyebrow">{copy.notes.eyebrow}</p>
  <div class="section-heading">
    <h2 id="notes-title">{copy.notes.title}</h2>
    <p>{copy.notes.description}</p>
  </div>
  <div class="notes-list">
    {notes.map((note) => (
      <a class="note-row" href={`/notes/${note.id}/`}>
        <span class="note-category">{note.data.category}</span>
        <div>
          <h3>{note.data.title}</h3>
          <p>{note.data.description}</p>
        </div>
        <span class="note-reading mono">{note.data.readingTime}</span>
        <span class="note-arrow">
          <Icon />
        </span>
      </a>
    ))}
  </div>
</section>
