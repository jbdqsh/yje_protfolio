---
import type { Project } from '../data/projects';
import { Image } from 'astro:assets';
import '../styles/project-media.css';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const cover = project.images[0];
---

<div class:list={['project-media', 'project-card-cover', `media-${project.theme}`]}>
  <div class="cover-stage">
    <Image
      src={cover.src}
      alt={cover.alt}
      format="webp"
      widths={[480, 800, 1200].filter((width) => width < cover.src.width).concat(cover.src.width)}
      sizes="(max-width: 640px) calc(100vw - 96px), (max-width: 1024px) calc((100vw - 200px) / 2), 540px"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>
