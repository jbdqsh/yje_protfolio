---
import type { Project } from '../data/projects';
import { Image } from 'astro:assets';
import '../styles/project-media.css';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const cover = project.images[0];
---

<div class:list={['project-media', `media-${project.theme}`]}>
  <div class="media-heading mono">
    <span>{project.label}</span>
    <span>项目实录 / {project.number}</span>
  </div>
  <div class="cover-stage">
    <Image
      src={cover.src}
      alt={cover.alt}
      format="webp"
      widths={[480, 800, 1200].filter((width) => width < cover.src.width).concat(cover.src.width)}
      sizes="(max-width: 640px) calc(100vw - 80px), (max-width: 800px) calc(100vw - 110px), 560px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="media-footer">
    <span>{cover.title}</span>
    <span>
      {project.images.length > 1 ? `${project.images.length} 张影像 · 查看项目` : '查看项目'}{' '}
      <span aria-hidden="true">↗</span>
    </span>
  </div>
</div>
