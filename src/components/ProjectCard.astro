---
import type { Project } from '../data/projects';
import { copy } from '../data/site';
import ProjectCover from './ProjectCover.astro';
import Icon from './Icon.astro';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="project-card">
  <a
    class="cover-link"
    href={`/projects/${project.slug}/`}
    aria-label={`查看${project.name}项目详情`}
  >
    <div aria-hidden="true">
      <ProjectCover project={project} />
    </div>
  </a>
  <div class="project-card-body">
    <div class="project-card-meta">
      <span class="mono">{project.number} /</span>
      <span>{project.category}</span>
      {project.kind === 'concept' && <span class="concept-badge">概念设计</span>}
    </div>
    <h3>
      <a href={`/projects/${project.slug}/`}>{project.name}</a>
    </h3>
    <p class="project-card-summary">{project.summary}</p>
    <div
      class="tags"
      title={project.tags.join(' · ')}
      role="group"
      aria-label={project.tagsLabel ?? '技术栈'}
    >
      {project.tags.map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
    <a class="project-card-link" href={`/projects/${project.slug}/`}>
      {copy.projects.link}
      <Icon size={18} />
    </a>
  </div>
</article>
