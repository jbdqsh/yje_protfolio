---
import { profile } from '../data/site';
import Icon from './Icon.astro';
import HeroDiagram from './HeroDiagram.astro';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-kicker">
    <span class="mono">
      {profile.englishName} / {profile.role}
    </span>
  </div>
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">
        {profile.headline.map((line, i) => (
          <span class:list={{ accent: i === 2 }}>{line}</span>
        ))}
      </h1>
      <p>{profile.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">
          查看我的项目 <Icon />
        </a>
        <a class="button button-secondary" href={profile.resume} download>
          下载简历 <Icon name="download" size={18} />
        </a>
      </div>
    </div>
    <HeroDiagram />
  </div>
  <div class="hero-bottom">
    <span class="mono">JAVA / SYSTEM DESIGN / AI EXPLORATION</span>
    <a href="#projects">
      向下探索 <span>↓</span>
    </a>
  </div>
</section>
